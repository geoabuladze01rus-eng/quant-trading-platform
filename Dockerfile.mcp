FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    MCP_TRANSPORT=streamable-http

WORKDIR /app

COPY pyproject.toml README.md constraints-py311-linux.txt ./
COPY src ./src

RUN pip install --no-cache-dir -c constraints-py311-linux.txt -e '.[mcp]'

EXPOSE 8080

CMD ["python", "-m", "quant_trading_platform.mcp.server"]
