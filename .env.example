APP_ENV=development
LOG_LEVEL=INFO
TRADING_MODE=paper
MARKET_SCOPE=mixed
LIVE_TRADING_ENABLED=false
MAX_DAILY_LOSS_PCT=2
MAX_TRADE_NOTIONAL_USD=100
MIN_EXPECTED_NET_PCT=0.10
MAX_MARKET_DATA_AGE_MS=1000
PUBLIC_MARKET_DATA_ENABLED=true
MARKET_DATA_SYMBOL=BTC/USDT
MARKET_DATA_POLL_INTERVAL_SECONDS=1
# Deliberately false. This is an explicit human acceptance control, not a feature flag.
LIVE_ORDER_ACCEPTANCE_GATE=false
PAPER_DATABASE_PATH=data/paper_alpha.sqlite3
PAPER_ACCOUNT_ID=paper-default
PAPER_INITIAL_USDT=100000
PAPER_INITIAL_BTC=1
PAPER_INITIAL_ETH=10
PAPER_ALGORITHM_VERSION=paper-alpha-v1

# Public crypto data is keyless. Do not supply trading or withdrawal credentials.
T_INVEST_API_TOKEN=
T_INVEST_ACCOUNT_ID=
T_INVEST_SANDBOX=true
